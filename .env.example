# Copy to .env for local development. Placeholder values only; never commit real secrets.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL 17 (docker compose up -d postgres)
DATABASE_URL=postgresql://agentdrop:agentdrop@localhost:5433/agentdrop
# Production Compose requires a separate random password; match it in DATABASE_URL.
POSTGRES_PASSWORD=

# >= 32 random characters in production (openssl rand -base64 48)
AUTH_SECRET=GENERATE_SECURE_RANDOM_VALUE

# Optional Web Push. Generate once with `pnpm dlx web-push generate-vapid-keys`; set all three or none.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Optional: the server's own Feishu app (docs/FEISHU.md §10, ADR 0039): notices as cards to linked accounts.
# Set both or neither; the secret is the worker's (compose.production.yaml keeps it from the API).
# FEISHU_DOMAIN=lark for Lark (open.larksuite.com).
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional: mail password reset links. Unset = no email; administrators generate reset links in the dashboard.
# SMTP_URL holds a credential (smtps://user:pass@smtp.example.com:465). MAIL_FROM is required when it is set.
SMTP_URL=
MAIL_FROM=

# Development: controlled filesystem storage. Production: s3 (private bucket).
STORAGE_PROVIDER=fs
FS_STORAGE_DIR=./data/storage
S3_ENDPOINT=REPLACE_OR_OMIT_FOR_AWS
S3_REGION=REPLACE
S3_BUCKET=PRIVATE_BUCKET
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE

MAX_FILE_BYTES=52428800
MAX_DROP_FILE_BYTES=104857600
H_STORAGE_QUOTA_BYTES=1073741824
# File space of every group (ADR 0029); admins can change it at run time in Settings
GROUP_STORAGE_QUOTA_BYTES=536870912
MAX_GROUP_RECIPIENTS=50
# Webhooks to loopback/private/link-local/metadata addresses are refused unless this is true (API and worker).
WEBHOOK_ALLOW_PRIVATE_NETWORK=false
# Worker: longest one outbox handler may run before the attempt counts as failed.
WORKER_HANDLER_TIMEOUT_S=300
H_CREDENTIAL_MAX_DAYS=90
LOG_LEVEL=info
LOG_CONTENT=false
DEV_AUTH=false
